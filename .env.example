# ==================================================
# INSTAGRAM AUDIENCE ANALYZER CONFIGURATION
# ==================================================

# FastAPI API settings
PROJECT_NAME="Instagram Audience Analyzer API"
SECRET_KEY="antigravity_ig_analyzer_super_secret_key_2026"

# Database Connection (PostgreSQL - e.g. Supabase)
# format: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/instagram_analyzer"

# Cache & Rate Limiting (Redis Cache)
# format: redis://[:password@]host:port[/db]
REDIS_URL="redis://localhost:6379/0"

# Rate limit settings (limits per ip address per minute)
RATE_LIMIT_PER_MINUTE=30

# Playwright Scraper configs
PLAYWRIGHT_HEADLESS=true
PROXY_SERVER="" # Optional format: http://username:password@ip:port
